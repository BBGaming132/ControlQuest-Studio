rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Older open tabs can still read backups of their study state. App writes
    // are fenced here so that the Supabase release has one writable database.
    match /users/{uid}/{document=**} {
      allow read: if isSelf(uid);
    }
    match /groups/{document=**} {
      allow read: if signedIn();
    }
    match /{collection}/{document} {
      allow read: if signedIn() && collection in [
        'publicLessonContributions', 'publicLessonStatus',
        'publicStudyDecks', 'publicStudyCards'
      ];
    }
    match /deletedProfiles/{uid}/backups/{backupId} {
      allow read: if isSelf(uid);
    }
  }
}
