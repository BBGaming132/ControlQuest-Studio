rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /studyDecks/{deckId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyCards/{cardId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyProgress/{progressId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyReviews/{reviewId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    match /groups/{groupId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /studyDecks/{deckId} {
        allow read, create, update, delete: if signedIn();
      }
      match /studyCards/{cardId} {
        allow read, create, update, delete: if signedIn();
      }
      match /studyReviews/{reviewId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    match /publicStudyDecks/{deckId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /publicStudyCards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /deletedProfiles/{uid}/backups/{backupId} {
      allow read, create: if isSelf(uid);
      allow update, delete: if false;
    }
  }
}
