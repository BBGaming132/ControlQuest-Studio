rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /studyDecks/{deckId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyCards/{cardId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyProgress/{progressId} {
        allow read, create, update, delete: if isSelf(uid);
      }
      match /studyReviews/{reviewId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    match /groups/{groupId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /studyDecks/{deckId} {
        allow read, create, update, delete: if signedIn();
      }
      match /studyCards/{cardId} {
        allow read, create, update, delete: if signedIn();
      }
      match /studyReviews/{reviewId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    // Each member owns their contribution. Community decks are derived on read,
    // so members never need permission to overwrite another member's questions.
    match /publicLessonContributions/{submissionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','ownerUid','contributorName','sourceKey','sourceTitle','sourceUploader','lessonId','fingerprint','identity','question','choices','correctAnswer','justifications','source','updatedAt'])
        && request.resource.data.id == submissionId
        && request.resource.data.lessonId.matches('^(d[1-5]-t[0-9]{2}|pe-[1-3])$');
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.keys().hasOnly(['id','ownerUid','contributorName','sourceKey','sourceTitle','sourceUploader','lessonId','fingerprint','identity','question','choices','correctAnswer','justifications','source','updatedAt'])
        && request.resource.data.lessonId.matches('^(d[1-5]-t[0-9]{2}|pe-[1-3])$');
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /publicLessonStatus/{lessonId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && lessonId.matches('^(d[1-5]-t[0-9]{2}|pe-[1-3])$')
        && request.resource.data.keys().hasOnly(['completed','updatedBy','updatedByName','updatedAt'])
        && request.resource.data.completed is bool
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /publicStudyDecks/{deckId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /publicStudyCards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /deletedProfiles/{uid}/backups/{backupId} {
      allow read, create: if isSelf(uid);
      allow update, delete: if false;
    }
  }
}
